rules_version = '2';
service cloud.firestore {
  match /databases/jing-finance/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /holdings/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /monthlyConfigs/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /snapshots/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
