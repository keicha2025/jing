rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 使用者基本設定：以 UID 為文件 ID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 庫存持股：含有 uid 欄位
    match /holdings/{holdingId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    
    // 每月配置：以 UID 為文件 ID
    match /monthlyConfigs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 快照紀錄：含有 uid 欄位
    match /snapshots/{snapshotId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 股票快取：公開讀取（或僅限登入使用者），僅由 Admin (Functions) 寫入
    match /stockCache/{symbol} {
      allow read: if request.auth != null;
      allow write: if false; // 僅限 Functions
    }
  }
}
