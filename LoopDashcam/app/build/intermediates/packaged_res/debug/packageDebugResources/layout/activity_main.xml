<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- OpenGL GPU Rendering Surface -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Left: Storage Info -->
    <LinearLayout
        android:id="@+id/storageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_save"
            android:tint="#64748B" />
            
        <TextView
            android:id="@+id/tvStorageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="剩餘 8.2 GB | 循環開"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Right: Quality & Settings -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080P"
                android:textColor="#1E293B"
                android:textStyle="bold"
                android:textSize="12sp" />
            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/dot_gray" />
            <TextView
                android:id="@+id/tvFPS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60FPS"
                android:textColor="#D97706"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_glass_circle"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#334155" />
    </LinearLayout>

    <!-- Bottom Center: Shutter Button -->
    <FrameLayout
        android:id="@+id/btnShutter"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_shutter_outer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/shutterInner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter_inner" />
            
        <TextView
            android:id="@+id/tvRecTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_timer"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="#DC2626"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
    
    <!-- Bottom Left: Speed Toggle -->
    <ImageButton
        android:id="@+id/btnToggleSpeed"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        android:background="@drawable/bg_glass_circle"
        android:src="@android:drawable/ic_menu_view"
        android:tint="#475569"
        app:layout_constraintBottom_toBottomOf="@+id/btnShutter"
        app:layout_constraintTop_toTopOf="@+id/btnShutter"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Right: Switch Camera -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_glass_circle"
        android:src="@android:drawable/ic_menu_camera"
        android:tint="#475569"
        app:layout_constraintBottom_toBottomOf="@+id/btnShutter"
        app:layout_constraintTop_toTopOf="@+id/btnShutter"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
