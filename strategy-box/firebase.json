{
  "hosting": {
    "site": "jing-lab",
    "public": "deploy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/finance/**",
        "destination": "/finance/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}