{
    "name": "Personal Note",
    "short_name": "Note",
    "id": "com.jinglab.note",
    "start_url": "/note",
    "scope": "/note",
    "display": "standalone",
    "launch_handler": {
        "client_mode": [
            "focus-existing",
            "auto"
        ]
    },
    "orientation": "portrait",
    "background_color": "#FDFCFB",
    "theme_color": "#4A4A4A",
    "categories": [
        "productivity",
        "utilities"
