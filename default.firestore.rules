rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /configs/project_index {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "wj209ing@gmail.com";
    }
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "wj209ing@gmail.com";
    }
  }
}
